# Virtual environments
.venv/
venv/

# Python build and cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Documentation build
docs/_build/

# Hyperion model inputs and outputs, and the compendium tabulations themselves.
# These are large, reproducible from the configuration, and published to Zenodo
# rather than tracked here. Anchored to the repository root, so that package
# data such as src/dustcompendium/dust/data/ is not swept up with it.
/data/
*.hdf5
*.rtout
*.pbs
*.log

# Generated study manifests and summaries.
/studies/*/generated-configs/
/studies/*/results.csv

# Editor and OS clutter
.DS_Store
*~
.idea/
.vscode/
